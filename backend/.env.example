# Copy to backend/.env — NEVER commit .env
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
ALLOW_ORG_SIGNUP=true

# --- LLM providers (at least one required for answer generation) ---
# Order below is the failover order.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (optional: hybrid dense+BM25 retrieval) ---
# auto = use OpenAI if OPENAI_API_KEY is set, else Gemini, else BM25-only.
EMBED_PROVIDER=auto
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_EMBED_MODEL=text-embedding-004

# --- Database ---
# Local dev: leave unset → SQLite file in backend/data/ (dev only).
# Production (Vercel): MUST be a persistent PostgreSQL URL, e.g.
#   postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Misc ---
MIN_RERANK_SCORE=0.05
# Vercel Functions accept max ~4.5 MB per request body.
MAX_UPLOAD_MB=4

# Uploaded to Vercel only when using `vercel deploy` from the CLI;
# gitignore-style patterns, applied to the whole upload (all services).
# Local dev is unaffected — these files stay on this machine.
.vercel/
node_modules/
**/__pycache__/
**/*.pyc
backend/.venv/
backend/data/
backend/.env
.env
.env.local
legacy/
web/.next/
